# Base URL of the BitEat API (the Express server in ../api).
#
# Android emulator  -> http://10.0.2.2:5000
# iOS simulator     -> http://localhost:5000
# Physical device   -> http://<your-computer-LAN-IP>:5000  (e.g. http://192.168.1.20:5000)
# Deployed backend  -> https://your-biteat-deployment.vercel.app
#
# Must be prefixed with EXPO_PUBLIC_ to be readable from app code.
EXPO_PUBLIC_API_URL=http://localhost:5000
