{
  "expo": {
    "name": "BitEat",
    "slug": "biteat-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "biteat",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ea580c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biteat.mobile"
    },
    "android": {
      "package": "com.biteat.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#ea580c"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "http://localhost:5000"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
