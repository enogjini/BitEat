{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm install --prefix f",
  "buildCommand": "CI=false npm run build --prefix f",
  "outputDirectory": "f/build",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/health", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  }
}
