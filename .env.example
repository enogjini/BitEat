# ============================================================================
# BitEat - Environment configuration
# Copy to .env for local dev. In production these are set in the Vercel
# project settings, NOT committed.
# ============================================================================

# Postgres connection string.
# Local dev: your local Postgres.
# Production: the Supabase *connection pooler* string (port 6543, ?pgbouncer=true),
#   e.g. postgresql://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:123@localhost:5432/restaurant

# Force SSL on the DB connection (auto-enabled for supabase/render/neon hosts).
# PGSSL=true

# Local API port (ignored on Vercel).
PORT=5000

# Signs the session tokens issued by POST /api/login. REQUIRED in production —
# the API refuses to start a session without it. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs everyone out.
JWT_SECRET=

# Origins allowed to call the API from a browser (comma-separated, or '*').
# Not needed in production: Vercel serves the front end same-origin.
# Outside production it defaults to the CRA dev server, http://localhost:3000.
# CORS_ORIGIN=http://localhost:3000

# Frontend -> API base URL.
# Leave empty in production: the API is served same-origin at /api/* by Vercel.
# For local dev against a separately-running API: http://localhost:5000
REACT_APP_API_URL=

# The restaurant's timezone. Reservation times are wall-clock; the database is
# UTC, so the floor view needs this to know what "today" and "now" mean.
# TZ_RESTORANTI=Europe/Tirane
